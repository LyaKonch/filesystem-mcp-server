# ============================================
# MCP Filesystem Server Configuration
# ============================================

# --- Server Settings ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
TRANSPORT=sse  # Options: stdio, sse, http
DEBUG=false

# --- GitHub Authentication ---
# Enable/disable authentication
AUTH_ENABLED=true

# GitHub OAuth App credentials
# Create app at: https://github.com/settings/developers
FASTMCP_SERVER_AUTH_GITHUB_CLIENT_ID=your_client_id_here
FASTMCP_SERVER_AUTH_GITHUB_CLIENT_SECRET=your_client_secret_here
FASTMCP_SERVER_AUTH_GITHUB_BASE_URL=http://127.0.0.1:8000

# Admin users (GitHub usernames or IDs, comma-separated)
# Only these users have access to dangerous operations:
# - delete_file, delete_directory
# - write_file (in restricted areas)
# - add_allowed_root, update_roots, remove_root
# 
# Example: ADMIN_GITHUB_IDS=octocat,github-user-123,admin-user
ADMIN_GITHUB_IDS=

# --- Security & Storage ---
# Enable persistent storage for auth sessions
USE_PERSISTENT_STORAGE=false

# JWT signing key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SIGNING_KEY=

# Storage encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
STORAGE_ENCRYPTION_KEY=

# Use Redis for session storage (requires Redis server)
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Filesystem Settings ---
# Please specify allowed root directories for file operations 
ALLOWED_ROOTS=["yourpath1","yourpath2"]

# ============================================
# SECURITY NOTES
# ============================================
#
# 1. ADMIN_GITHUB_IDS:
#    - Leave empty for read-only access for all authenticated users
#    - Add your GitHub username/ID to enable dangerous operations
#    - Find your GitHub ID at: https://api.github.com/users/YOUR_USERNAME
#
# 2. AUTH_ENABLED:
#    - Set to false ONLY for local development
#    - In production, ALWAYS use authentication
#
# 3. Dangerous Paths:
#    - Never add system directories to ALLOWED_ROOTS:
#      Windows: C:\Windows, C:\Program Files
#      Linux: /root, /etc, /sys, /proc, /boot
#
# 4. Transport Security:
#    - Use 'stdio' for local Claude Desktop integration
#    - Use 'sse' or 'http' with authentication for network access
#
# ============================================
