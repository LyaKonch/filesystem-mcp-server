            "W32Time",
            "MyService"
          ]
        },
        "service.create_service": {
          "allowed_services": [
            "MyService"
          ],
          "allowed_paths": [
            "G:/Koblenzessentials/Projects",
            "C:/Python314/python.exe"
          ]
        },
        "service.delete_service": {
          "allowed_services": [
            "MyService"
          ]
        },
        "service.wrap_script_as_service": {
          "allowed_services": [
            "MyService"
          ],
          "allowed_paths": [
            "G:/Koblenzessentials/Projects",
            "C:/Python314/python.exe"
          ]
        }
      }
